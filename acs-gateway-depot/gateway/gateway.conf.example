# Factory+ cell gateway settings.
#
# Copy this to gateway.conf, or let start.sh ask the questions and write
# /etc/fplus-gw/gateway.conf for you. Every value has a default, so an
# empty file gives a single-node gateway with automatic port detection.

# gateway: a physical box with a northbound port and a southbound port.
# server:  an IT-hosted VM. Network, hostname and password are left alone.
ROLE=gateway

# create: start a new single-node K3s cluster on this machine.
# join:   join an existing cluster as an agent (needs K3S_URL and K3S_TOKEN).
K3S_MODE=create
K3S_URL=
K3S_TOKEN=

# yes: set everything up except K3s. The Gateway Depot uses this so the
# cluster is only created once the gateway is at the edge.
K3S_DEFER=no

# yes: other machines will join this cluster, so the firewall also lets
# cluster nodes reach each other on the northbound port. join implies yes.
MULTI_NODE=no

# The northbound port. auto picks the port that carries the default
# route, or the port that can reach NORTH_PROBE_URL if you set one. A
# probe is the safer choice if the machine network has its own DHCP
# server. Or give an interface name or a MAC address.
NORTH_IF=auto
NORTH_PROBE_URL=

# The southbound port. auto picks the only other wired
# port. Or give an interface name, a MAC address, or none.
SOUTH_IF=auto

# The address for the southbound port, as address/prefix, for example
# 192.168.1.200/24. Use dhcp if the machine network hands out addresses.
# Either way the southbound port never gets a default route.
SOUTH_ADDR=

# The hostname is HOSTNAME_PREFIX-<serial number>. Set GW_HOSTNAME to
# override the whole name.
HOSTNAME_PREFIX=fpcgw
GW_HOSTNAME=

# Container images are pulled through this mirror. Leave empty to pull
# straight from docker.io and ghcr.io.
REGISTRY_MIRROR=

# An apt mirror to use instead of the Ubuntu archive. Leave empty to keep
# the Ubuntu sources. The mirror should carry the -updates and -security
# suites as well as the release, or gateways get no updates.
#
# APT_MIRROR_KEY is the mirror's signing key (armored or binary) as one
# line of base64, for example the output of `base64 -w0 key.asc`. Set it
# when the mirror does not publish its key. If it is empty, the key is
# fetched from <APT_MIRROR>/keyring.gpg and APT_MIRROR_KEY_SHA256 must be
# set. APT_MIRROR_KEY_SHA256 is the SHA-256 of the key file, and is
# checked against either key when it is set.
APT_MIRROR=
APT_MIRROR_KEY=
APT_MIRROR_KEY_SHA256=

# The origin the apt mirror publishes with. If empty, automatic updates
# accept any package from the mirror's host, which suits a mirror whose
# Release files have no Origin line.
APT_MIRROR_ORIGIN=

# keep:   leave the admin password alone.
# random: set a random password and show it once (interactive runs only).
ADMIN_PASSWORD=keep
