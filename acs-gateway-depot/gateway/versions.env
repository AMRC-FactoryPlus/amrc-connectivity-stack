# Pinned versions and checksums. depot/fetch.sh and sh/k3s-setup.sh read this.
#
# K3s must be a Kubernetes version that the Flux release in ACS supports.
# ACS installs Flux 2.7.x on edge clusters, which supports Kubernetes 1.32 to 1.34.
# When you change K3S_VERSION, also refresh sh/k3s.sh from the same tag:
#   https://raw.githubusercontent.com/k3s-io/k3s/<tag>/install.sh
K3S_VERSION="v1.34.13+k3s1"
K3S_SHA256_amd64="b9a7c47aab81db66d0253378ddea0d06f8a6dca4dace7a26db3f00fa2f0e3717"
K3S_SHA256_arm64="bad32c0c798bce0e883216ed755bbfb3c6a9fbd9b9f1dee32a6be16d256ad033"

UBUNTU_VERSION="24.04.5"
