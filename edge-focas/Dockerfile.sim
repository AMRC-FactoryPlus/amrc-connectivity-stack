# syntax=docker/dockerfile:1
#
# The fake FANUC control (src/bin/focas-sim.rs), for trying the driver
# without a machine. Not published: build it locally from the top of
# the repository with
#
#   docker buildx build --build-context lib=lib -f edge-focas/Dockerfile.sim -t focas-sim edge-focas
#   docker run --rm -p 8193:8193 focas-sim

ARG rust_version=1.99

FROM rust:${rust_version}-slim-trixie AS build
COPY --from=lib rs-edge-driver/Cargo.toml /src/lib/rs-edge-driver/
COPY --from=lib rs-edge-driver/src /src/lib/rs-edge-driver/src
COPY --from=lib rs-edge-driver/examples /src/lib/rs-edge-driver/examples
WORKDIR /src/driver
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN <<'SHELL'
    set -e
    cargo build --release --locked --bin focas-sim
    install -D target/release/focas-sim /out/focas-sim
SHELL

FROM gcr.io/distroless/cc-debian13:nonroot AS run
COPY --from=build /out/focas-sim /usr/local/bin/focas-sim
USER nonroot
EXPOSE 8193
ENTRYPOINT ["/usr/local/bin/focas-sim"]
